{
  "name": "web3-storage-ui",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @web3-storage/papi run papi:install",
    "papi:generate": "pnpm --filter @web3-storage/papi run papi:generate",
    "papi:check": "pnpm --filter @web3-storage/papi run papi:check",
    "test:unit": "pnpm --filter @web3-storage/drive-ui --filter provider-dashboard --if-present run test:unit",
    "test:e2e:drive-ui": "pnpm --filter @web3-storage/drive-ui run test",
    "test:e2e:console-ui": "pnpm --filter @web3-storage/console-ui run test",
    "test:e2e:provider": "pnpm --filter provider-dashboard run test:e2e"
  }
}
