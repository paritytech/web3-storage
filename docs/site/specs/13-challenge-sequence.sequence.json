        "note": "A provider signature from POST /commit or GET /commitment, or the on-chain snapshot for a cold bucket."
      },
      {
        "id": "create",
        "label": "Create",
        "focus": [
          "challenger",
          "pallet",
          "sweep",
          "holds"
        ],
        "note": "The pallet checks the caller, holds ChallengeDeposit and stores the challenge under its deadline."
      },
      {
        "id": "defend",
        "label": "Defend",
        "focus": [
          "provider",
          "pallet",
          "holds"
        ],
        "note": "A valid response before the deadline leaves the stake untouched. The deposit reimburses the response fee."
      },
      {
        "id": "timeout",
        "label": "Timeout and slash",
        "focus": [
          "challenger",
          "pallet",
          "sweep",
          "holds"
        ],
        "note": "The on_initialize sweep slashes the full stake of a provider that did not respond before the deadline."
      }
    ]
