        "id": "defend",
        "label": "Defend",
        "focus": [
          "provider",
          "pallet",
          "holds"
        ],
        "note": "A valid response before the deadline leaves the stake untouched. The deposit reimburses the response fee."
      },
      {
        "id": "timeout",
        "label": "Timeout and slash",
        "focus": [
          "challenger",
          "pallet",
          "challenges",
          "holds"
        ],
        "note": "After the deadline anyone calls resolve_expired_challenge; it slashes the full stake of a provider that did not respond."
      }
    ]
