      "label": "deadline passed: slash full ProviderStake, release ChallengeDeposit",
      "variant": "security",
      "note": "challenger made whole, no reward"
    },
    {
      "id": "slashed",
      "from": "sweep",
      "to": "provider",
      "y": 578,
      "label": "ChallengeSlashed { reason: Timeout }",
