  "cards": [
    {
      "dot": "cyan",
      "title": "Which challenge extrinsic",
      "items": [
        "challenge_checkpoint: cold buckets, snapshot as evidence",
        "challenge_offchain: hot buckets, signed commitment",
        "challenge_replica: replicas, confirmed sync root as evidence"
      ]
    },
    {
      "dot": "rose",
      "title": "Invalid response",
      "items": [
        "Rejected with InvalidProof, InvalidDeletionClaim or InvalidSupersededClaim; the provider pays the tx fee",
        "The challenge stays open; the provider may answer again before the deadline",
        "Only a timeout slashes: resolve_expired_challenge after the deadline"
      ]
    },
    {
      "dot": "amber",
      "title": "PendingChallenges",
      "items": [
        "Gates complete_deregister; the provider may call resolve_expired_challenge itself",
        "PendingChallengesByBucket gates end_agreement, claim_expired_agreement",
        "Each resolution decrements both once"
      ]
    }
  ]
