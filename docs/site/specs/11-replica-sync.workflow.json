    { "id": "node_source", "lane": "sources", "col": 4, "type": "cloud", "label": "Node Source", "sublabel": "any data holder", "width": 140 },
    { "id": "mismatch", "lane": "recovery", "col": 2, "type": "security", "label": "Peak Mismatch", "sublabel": "source rejected", "width": 140 }
  ],
  "edges": [
