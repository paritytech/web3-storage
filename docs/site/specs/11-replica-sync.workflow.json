    { "id": "traverse", "lane": "replica", "col": 3, "type": "backend", "label": "Top-Down Walk", "sublabel": "GET /mmr_subtree", "width": 140 },
    { "id": "fetch_nodes", "lane": "replica", "col": 4, "type": "backend", "label": "Fetch Missing Nodes", "sublabel": "POST /fetch_nodes", "width": 150 },
    { "id": "confirm", "lane": "replica", "col": 5, "type": "backend", "label": "confirm_replica_sync", "sublabel": "roots[7] + signature", "width": 150 },
