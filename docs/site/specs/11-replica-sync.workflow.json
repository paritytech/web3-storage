      { "id": "happy-path", "label": "Chain-first sync", "focus": ["snapshot", "read_chain", "fetch_peaks", "verify", "traverse", "fetch_nodes", "confirm", "sync_check"], "note": "The replica reads the trusted root from the chain and verifies every fetched node against it." },
      { "id": "untrusted-sources", "label": "Untrusted sources", "focus": ["peak_source", "node_source", "verify", "mismatch"], "note": "Any data holder can serve. The replica rejects a source whose peaks do not hash to the chain root." },
      { "id": "payment", "label": "Confirmation and payment", "focus": ["confirm", "sync_check", "sync_balance"], "note": "confirm_replica_sync pays sync_price from sync_balance when the root is new and min_sync_interval has passed." }
    ]
  },
  "lanes": [
    { "id": "chain", "label": "Chain" },
