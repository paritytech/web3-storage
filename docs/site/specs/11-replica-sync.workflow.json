    { "id": "sources", "label": "Data Sources" },
    { "id": "recovery", "label": "Recovery", "variant": "exception" }
  ],
  "phases": [
    { "id": "anchor", "label": "Trusted root", "fromCol": 0, "toCol": 1 },
    { "id": "walk", "label": "Verify and walk", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "settle", "label": "Fetch and confirm", "fromCol": 4, "toCol": 5 }
  ],
  "mainPath": ["read_chain", "fetch_peaks", "verify", "traverse", "fetch_nodes", "confirm", "sync_check"],
  "nodes": [
    { "id": "snapshot", "lane": "chain", "col": 0, "type": "database", "label": "Bucket State", "sublabel": "snapshot, historical_roots", "width": 150 },
    { "id": "sync_balance", "lane": "chain", "col": 4, "type": "database", "label": "sync_balance", "sublabel": "held on owner", "width": 140 },
    { "id": "sync_check", "lane": "chain", "col": 5, "type": "security", "label": "Match and Pay", "sublabel": "sync_price per sync", "tag": "ReplicaSynced", "width": 150 },
    { "id": "read_chain", "lane": "replica", "col": 0, "type": "backend", "label": "Read Chain State", "sublabel": "runtime API", "width": 140 },
