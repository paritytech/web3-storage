{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Challenge Protocol",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy-path",
        "label": "Defended challenge",
        "focus": [
          "open",
          "gate",
          "window",
          "respond",
          "verify",
          "defended"
        ],
        "note": "A valid response before the deadline leaves the stake untouched. The deposit reimburses the response fee per tier."
      },
      {
        "id": "gate-view",
        "label": "Who may challenge",
        "focus": [
          "open",
          "gate",
          "denied"
        ],
        "note": "The chain rejects a self-challenge, and a private-bucket primary challenge from a non-member without a primary agreement."
      },
      {
        "id": "failure",
        "label": "Slash",
        "focus": [
          "window",
          "verify",
          "sweep",
          "slashed"
        ],
        "note": "An invalid response or no response before ChallengeTimeout slashes the full stake."
      },
      {
        "id": "exit",
        "label": "Cancel",
        "focus": [
          "open",
          "window",
          "cancelled"
        ],
        "note": "The design doc allows cancel before the response. The implementation doc defines no cancel extrinsic yet."
      }
    ]
  },
