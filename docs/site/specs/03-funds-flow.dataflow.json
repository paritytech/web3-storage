  "cards": [
    {
      "dot": "cyan",
      "title": "Three hold reasons",
      "items": [
        "ProviderStake: provider collateral",
        "AgreementPayment: fee, sync_balance and a pending replacement's payment, on the owner; moves on transfer_agreement_ownership",
        "ChallengeDeposit: challenger deposit"
      ]
    },
    {
      "dot": "rose",
      "title": "Stake and challenges",
      "items": [
        "Unanswered challenge: resolve_expired_challenge slashes to the Treasury; a physical provider loses its whole held stake, each liable member of a virtual provider its per_provider_stake",
        "Challenger made whole from the slash, no reward",
        "Any response leaves the stake untouched; an invalid one is rejected",
        "Each agreement snapshots the stake at creation; set_stake lowers the figure for new agreements only, and the old one stays locked until cur_until, the latest expiry struck under it",
        "While the provider has an open challenge (pending_challenges > 0) every stake lock stays active and deregister_provider fails",
        "A slash bumps version; a provider below MinProviderStake takes no new or extended agreement (StakeBelowMinimum)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agreement payment",
      "items": [
        "Prepaid at creation and extension at the provider's current price; the client pins expected_version (ProviderVersionMismatch)",
        "refund_agreement: the provider returns the remaining payment; the agreement runs on unpaid and stays challengeable",
        "Replacement: at activation the old agreement's unelapsed remainder moves into the successor's escrow; the successor is then paid as any agreement",
        "Virtual provider: settlement pays the snapshotted members equally",
        "Open challenges do not hold the payment: settlement, burn, refund, extension and replacement activation proceed"
      ]
    },
    {
      "dot": "amber",
      "title": "Who pays the response cost",
      "items": [
        "Provider pays the fee from its own account",
        "Public challenger: deposit reimburses 100%",
        "Authorized: split by response time, challenger pays at least 50%"
      ]
    }
  ]
