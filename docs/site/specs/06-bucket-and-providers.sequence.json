{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Bucket Creation and Provider Assignment",
    "quality_profile": "showcase",
    "viewBox": [1040, 1000],
    "column_fit": "spread",
    "views": [
      {
        "id": "empty-bucket",
        "label": "Empty bucket",
        "focus": ["admin", "pallet"],
        "note": "create_bucket takes no provider and no terms. The caller becomes sole admin."
      },
      {
        "id": "new-with-primary",
        "label": "New bucket with primary",
        "focus": ["admin", "primary", "pallet", "holds"],
        "note": "Terms with BucketTarget::New create the bucket and its first primary in one call."
      },
      {
        "id": "add-primary",
        "label": "Primary on existing bucket",
        "focus": ["admin", "primary", "pallet", "holds"],
        "note": "Only a bucket admin can redeem primary terms for BucketTarget::Existing(id)."
      },
      {
        "id": "add-replica",
        "label": "Replica on existing bucket",
        "focus": ["funder", "replica", "pallet", "holds"],
        "note": "Any account the replica provider quoted as terms.owner can redeem."
      }
    ]
  },
  "participants": [
    { "id": "admin", "type": "external", "label": "Bucket Admin", "sublabel": "client account" },
    { "id": "funder", "type": "external", "label": "Replica Funder", "sublabel": "any account" },
    { "id": "primary", "type": "backend", "label": "Primary Provider", "sublabel": "provider node" },
    { "id": "replica", "type": "backend", "label": "Replica Provider", "sublabel": "provider node" },
    { "id": "pallet", "type": "backend", "label": "Storage Pallet", "sublabel": "extrinsics" },
    { "id": "holds", "type": "security", "label": "Holds", "sublabel": "on terms.owner" }
  ],
  "segments": [
    { "from": 150, "to": 250, "label": "create_bucket: empty bucket" },
    { "from": 265, "to": 475, "label": "create_bucket_with_primary: BucketTarget::New" },
    { "from": 490, "to": 700, "label": "add_primary_provider: BucketTarget::Existing(id)" },
    { "from": 715, "to": 925, "label": "add_replica_provider: replica_params set" }
  ],
  "messages": [
    { "id": "create", "from": "admin", "to": "pallet", "y": 185, "label": "create_bucket(min_providers, visibility)", "variant": "emphasis" },
    { "id": "created", "from": "pallet", "to": "admin", "y": 225, "label": "BucketCreated", "variant": "return" },

    { "id": "neg-new", "from": "admin", "to": "primary", "y": 300, "label": "POST /negotiate, bucket: null", "variant": "default" },
    { "id": "terms-new", "from": "primary", "to": "admin", "y": 340, "label": "signed AgreementTerms, BucketTarget::New", "variant": "return" },
    { "id": "redeem-new", "from": "admin", "to": "pallet", "y": 380, "label": "create_bucket_with_primary(provider, terms, sig, visibility)", "variant": "emphasis" },
