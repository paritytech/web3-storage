    { "id": "ev-new", "from": "pallet", "to": "admin", "y": 455, "label": "BucketCreated, ProviderAddedToBucket, StorageAgreementEstablished", "variant": "return" },

    { "id": "neg-existing", "from": "admin", "to": "primary", "y": 525, "label": "POST /negotiate, bucket: id", "variant": "default" },
