    { "id": "redeem-replica", "from": "funder", "to": "pallet", "y": 830, "label": "add_replica_provider(bucket_id, provider, terms, sig)", "variant": "emphasis" },
    { "id": "hold-replica", "from": "pallet", "to": "holds", "y": 870, "label": "hold AgreementPayment + sync_balance", "variant": "security" },
    { "id": "ev-replica", "from": "pallet", "to": "funder", "y": 905, "label": "replica agreement stored", "variant": "return" }
  ],
  "activations": [
    { "participant": "pallet", "from": 180, "to": 230, "type": "backend" },
    { "participant": "primary", "from": 295, "to": 345, "type": "backend" },
    { "participant": "pallet", "from": 375, "to": 460, "type": "backend" },
    { "participant": "primary", "from": 520, "to": 570, "type": "backend" },
    { "participant": "pallet", "from": 600, "to": 685, "type": "backend" },
    { "participant": "replica", "from": 745, "to": 795, "type": "backend" },
    { "participant": "pallet", "from": 825, "to": 910, "type": "backend" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Who may call",
      "items": [
        "create_bucket: anyone; the caller becomes sole admin",
        "create_bucket_with_primary: terms.owner; creates the bucket with min_providers = 1",
        "add_primary_provider: bucket admin (NotBucketAdmin)",
        "add_replica_provider: terms.owner, any account the provider quoted"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared checks on signed terms",
      "items": [
        "terms.bucket matches the call (TermsBucketMismatch); terms.owner matches the origin (TermsOwnerMismatch)",
        "now <= terms.valid_until <= now + RequestTimeout (TermsExpired / TermsValidityTooLong)",
        "Signature over blake2_256(context | SCALE(terms)); terms.nonce not replayed (NonceAlreadyUsed / NonceTooOld)",
        "Provider active, terms.max_bytes > 0 and within capacity and stake (CapacityExceeded / InsufficientStakeForBytes)"
      ]
    },
    {
      "dot": "amber",
      "title": "Role-specific checks",
      "items": [
        "Primary: replica_params = None, ProviderNotAcceptingPrimary, MaxPrimaryProvidersReached",
        "Replica: replica_params = Some (MissingReplicaTerms), ProviderNotAcceptingReplicas",
        "Existing bucket: BucketNotFound, AgreementAlreadyExists",
        "Held payment: terms.price_per_byte * terms.max_bytes * terms.duration"
      ]
    }
  ]
}
