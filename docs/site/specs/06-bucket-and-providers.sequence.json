    { "id": "redeem-existing", "from": "admin", "to": "pallet", "y": 605, "label": "add_primary_provider(bucket_id, provider, terms, sig)", "variant": "emphasis" },
    { "id": "hold-existing", "from": "pallet", "to": "holds", "y": 645, "label": "hold AgreementPayment", "variant": "security" },
    { "id": "ev-existing", "from": "pallet", "to": "admin", "y": 680, "label": "ProviderAddedToBucket, StorageAgreementEstablished", "variant": "return" },

